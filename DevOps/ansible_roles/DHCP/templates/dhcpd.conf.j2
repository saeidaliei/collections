authoritative;
default-lease-time 600;
max-lease-time 7200;
log-facility local7;
ddns-update-style none;

option arch code 93 = unsigned integer 16;

subnet {{ dhcpd_subnet  }} netmask {{ dhcpd_netmask  }} {
    range {{ dhcpd_range }};
    option domain-name-servers {{ dhcpd_subnet }}, 8.8.8.8;
    {% if dhcpd_routers is defined and dhcpd_routers|length > 0 %}
    option routers {{ dhcpd_routers }};
    {% endif %}
    {% if dhcpd_next_server is defined and dhcpd_next_server|length > 0 %}
    next-server {{ dhcpd_next_server }};
    {% endif %}

    {% if dhcpd_is_pxe %}
    if option arch = 00:07 {
        filename "uefi/shimx64.efi";
    } else if option arch = 00:0b {
        filename "uefi/shimaa64.efi";
    } else {
        filename "pxelinux.0";
    }
    {% endif %}
}
